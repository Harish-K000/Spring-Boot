DB_HOST=localhost
DB_PORT=5433
DB_NAME=platform
DB_USER=platform
DB_PASS=platform

# Generate a local value with: openssl rand -base64 48
JWT_SECRET=

# Internal service locations used by the gateway and checkout coordinator.
INVENTORY_SERVICE_URI=http://localhost:8083
ORDERS_SERVICE_URI=http://localhost:8082
PAYMENTS_SERVICE_URI=http://localhost:8084

# Deterministic local provider. Replace with a production adapter before handling real payments.
PAYMENT_PROVIDER=sandbox

# Phase 7 outbox relay and Redis Stream worker.
REDIS_HOST=localhost
REDIS_PORT=6379
DOMAIN_EVENT_STREAM=platform:domain-events
DOMAIN_EVENT_GROUP=platform-workers
DOMAIN_EVENT_CONSUMER=platform-worker-local
OUTBOX_BATCH_SIZE=50
OUTBOX_RELAY_DELAY_MS=1000
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
DOMAIN_EVENT_BATCH_SIZE=25
DOMAIN_EVENT_POLL_DELAY_MS=500
DOMAIN_EVENT_PENDING_IDLE_SECONDS=10
DOMAIN_EVENT_MAX_DELIVERIES=5
DOMAIN_EVENT_DEAD_LETTER_STREAM=platform:domain-events:dead-letter
WORKER_PORT=8085

# Phase 8 reliability budgets.
INVENTORY_CONNECT_TIMEOUT=1s
INVENTORY_READ_TIMEOUT=2s
INVENTORY_RETRY_MAX_ATTEMPTS=2
INVENTORY_RETRY_INITIAL_BACKOFF=100ms
INVENTORY_RETRY_MAX_BACKOFF=500ms
ORDERS_CONNECT_TIMEOUT=1s
ORDERS_READ_TIMEOUT=2s
ORDERS_RETRY_MAX_ATTEMPTS=2
ORDERS_RETRY_INITIAL_BACKOFF=100ms
ORDERS_RETRY_MAX_BACKOFF=500ms
DB_CONNECTION_TIMEOUT_MS=3000
DB_VALIDATION_TIMEOUT_MS=1000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
SHUTDOWN_TIMEOUT=20s

# Structured logs and optional OpenTelemetry export.
LOG_FORMAT=logstash
TRACE_SAMPLING_PROBABILITY=0.1
OTEL_EXPORT_ENABLED=false
OTEL_EXPORT_ENDPOINT=http://localhost:4318/v1/traces
